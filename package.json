{
  "name": "groove-music-pass",
  "version": "1.0.0",
  "description": "Groove Music Pass - Windows Music Streaming & Spotify Migration App",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:unpacked": "electron-builder --win unpacked",
    "build:installers": "node scripts/build-installers.js"
  },
  "keywords": [
    "groove",
    "music",
    "pass",
    "spotify",
    "windows",
    "player"
  ],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "devDependencies": {
    "electron": "31.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.microsoft.groovemusicpass",
    "productName": "Groove Music Pass",
    "electronVersion": "31.0.0",
    "win": {
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
